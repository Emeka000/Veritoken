{
  "schema_version": 1,
  "profile": "development",
  "contracts": [
    {
      "name": "kyc_registry",
      "artifact": "${wasm_dir}/kyc_registry.wasm",
      "env_key": "VITE_KYC_REGISTRY_ID",
      "dependencies": [],
      "deployment_mode": "initialize",
      "initialize_function": "initialize",
      "initialize_args": {
        "admin": "${admin}"
      },
      "declared_metadata": {
        "package": "kyc-registry",
        "role": "identity_registry"
      },
      "health_check": {
        "function": "verifier_count",
        "expectation": "integer"
      }
    },
    {
      "name": "compliance_engine",
      "artifact": "${wasm_dir}/compliance_engine.wasm",
      "env_key": "VITE_COMPLIANCE_ENGINE_ID",
      "dependencies": [
        "kyc_registry"
      ],
      "deployment_mode": "initialize",
      "initialize_function": "initialize",
      "initialize_args": {
        "admin": "${admin}",
        "kyc_registry": "${contract.kyc_registry}",
        "rule_change_delay": 0
      },
      "declared_metadata": {
        "package": "compliance-engine",
        "role": "transfer_policy"
      },
      "health_check": {
        "function": "holder_count",
        "expectation": "integer"
      }
    },
    {
      "name": "invoice_token",
      "artifact": "${wasm_dir}/invoice_token.wasm",
      "env_key": "VITE_INVOICE_TOKEN_ID",
      "dependencies": [
        "kyc_registry",
        "compliance_engine"
      ],
      "deployment_mode": "constructor",
      "constructor_args": {
        "admin": "${admin}",
        "kyc_registry": "${contract.kyc_registry}",
        "compliance_engine": "${contract.compliance_engine}",
        "meta": {
          "invoice_id": "VERITOKEN-TEST-001",
          "issuer": "Veritoken Test Issuer",
          "debtor": "Veritoken Test Debtor",
          "face_value_usd": 10000000,
          "discount_rate_bps": 0,
          "due_date": 4102444800,
          "currency": "USD",
          "ipfs_doc_hash": "",
          "transfer_fee_bps": 0,
          "fee_recipient": null,
          "notification_webhook": ""
        }
      },
      "declared_metadata": {
        "package": "invoice-token",
        "role": "invoice_asset",
        "fixture_invoice_id": "VERITOKEN-TEST-001"
      },
      "health_check": {
        "function": "total_supply",
        "args": {
          "invoice_id": "VERITOKEN-TEST-001"
        },
        "expectation": "integer"
      }
    },
    {
      "name": "property_token",
      "artifact": "${wasm_dir}/property_token.wasm",
      "env_key": "VITE_PROPERTY_TOKEN_ID",
      "dependencies": [
        "kyc_registry",
        "compliance_engine"
      ],
      "deployment_mode": "constructor",
      "constructor_args": {
        "admin": "${admin}",
        "kyc_registry": "${contract.kyc_registry}",
        "compliance_engine": "${contract.compliance_engine}",
        "meta": {
          "property_id": "VERITOKEN-TEST-PROPERTY-001",
          "legal_name": "Veritoken Test Property LLC",
          "jurisdiction": "US",
          "address": "Testnet fixture only",
          "total_valuation_usd": 10000000,
          "total_shares": 1000000,
          "property_type": "residential",
          "ipfs_title_hash": "",
          "kyc_tier_required": 1
        }
      },
      "declared_metadata": {
        "package": "property-token",
        "role": "property_asset",
        "fixture_property_id": "VERITOKEN-TEST-PROPERTY-001"
      },
      "health_check": {
        "function": "total_shares",
        "expectation": "integer"
      }
    },
    {
      "name": "carbon_credit_token",
      "artifact": "${wasm_dir}/carbon_credit_token.wasm",
      "env_key": "VITE_CARBON_TOKEN_ID",
      "dependencies": [
        "kyc_registry",
        "compliance_engine"
      ],
      "deployment_mode": "constructor",
      "constructor_args": {
        "admin": "${admin}",
        "kyc_registry": "${contract.kyc_registry}",
        "compliance_engine": "${contract.compliance_engine}",
        "meta": {
          "project_id": "VERITOKEN-TEST-CARBON-001",
          "standard": "VCS",
          "vintage_year": 2024,
          "project_name": "Veritoken Test Carbon Project",
          "project_type": "forestry",
          "country": "US",
          "verifier": "Testnet fixture",
          "ipfs_cert_hash": "",
          "registry_url": "",
          "registry_project_id": "TEST-001"
        }
      },
      "declared_metadata": {
        "package": "carbon-credit-token",
        "role": "carbon_asset",
        "fixture_project_id": "VERITOKEN-TEST-CARBON-001"
      },
      "health_check": {
        "function": "total_supply",
        "expectation": "integer"
      }
    },
    {
      "enabled": false,
      "name": "rwa_token",
      "artifact": "${wasm_dir}/rwa_token.wasm",
      "env_key": "VITE_RWA_TOKEN_ID",
      "dependencies": [
        "kyc_registry",
        "compliance_engine"
      ],
      "deployment_mode": "constructor",
      "constructor_args": {
        "admin": "${admin}",
        "decimal": 7,
        "name": "Veritoken Test RWA",
        "symbol": "VT-RWA",
        "asset_type": "property",
        "kyc_registry": "${contract.kyc_registry}",
        "compliance_engine": "${contract.compliance_engine}",
        "compliance_metadata": null,
        "max_supply": 0
      },
      "declared_metadata": {
        "package": "rwa-token",
        "role": "generic_rwa_asset"
      },
      "health_check": {
        "function": "total_supply",
        "expectation": "integer"
      }
    }
  ]
}
