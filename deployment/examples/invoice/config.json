{
  "schema_version": 1,
  "profile": "development",
  "contracts": [
    {
      "name": "kyc_registry",
      "artifact": "${wasm_dir}/kyc_registry.wasm",
      "env_key": "VITE_KYC_REGISTRY_ID",
      "dependencies": [],
      "deployment_mode": "initialize",
      "initialize_function": "initialize",
      "initialize_args": {
        "admin": "${admin}"
      },
      "declared_metadata": {
        "package": "kyc-registry",
        "role": "identity_registry"
      },
      "health_check": {
        "function": "verifier_count",
        "expectation": "integer"
      }
    },
    {
      "name": "compliance_engine",
      "artifact": "${wasm_dir}/compliance_engine.wasm",
      "env_key": "VITE_COMPLIANCE_ENGINE_ID",
      "dependencies": [
        "kyc_registry"
      ],
      "deployment_mode": "initialize",
      "initialize_function": "initialize",
      "initialize_args": {
        "admin": "${admin}",
        "kyc_registry": "${contract.kyc_registry}",
        "rule_change_delay": 0
      },
      "declared_metadata": {
        "package": "compliance-engine",
        "role": "transfer_policy"
      },
      "health_check": {
        "function": "holder_count",
        "expectation": "integer"
      }
    },
    {
      "name": "invoice_token",
      "artifact": "${wasm_dir}/invoice_token.wasm",
      "env_key": "VITE_INVOICE_TOKEN_ID",
      "dependencies": [
        "kyc_registry",
        "compliance_engine"
      ],
      "deployment_mode": "constructor",
      "constructor_args": {
        "admin": "${admin}",
        "kyc_registry": "${contract.kyc_registry}",
        "compliance_engine": "${contract.compliance_engine}",
        "meta": {
          "invoice_id": "EXAMPLE-INVOICE-001",
          "issuer": "Example Issuer LLC",
          "debtor": "Example Debtor Inc",
          "face_value_usd": 5000000,
          "discount_rate_bps": 250,
          "due_date": 4102444800,
          "currency": "USD",
          "ipfs_doc_hash": "",
          "transfer_fee_bps": 0,
          "fee_recipient": null,
          "notification_webhook": ""
        }
      },
      "declared_metadata": {
        "package": "invoice-token",
        "role": "invoice_asset",
        "fixture_invoice_id": "EXAMPLE-INVOICE-001"
      },
      "health_check": {
        "function": "total_supply",
        "args": {
          "invoice_id": "EXAMPLE-INVOICE-001"
        },
        "expectation": "integer"
      }
    }
  ]
}
