# env/mainnet.env — Veritoken Stellar Mainnet configuration
#
# Used for production deployments.  Contract IDs here must be set after a
# successful mainnet deployment.  See docs/mainnet-deployment.md for the full
# deployment procedure.
#
# Load with:  bash scripts/load-env.sh mainnet
# Or copy:    cp env/mainnet.env frontend/.env
#
# WARNING: Never commit real contract IDs or secrets to version control.
#          Copy this file to frontend/.env and fill in the values locally.

VITE_STELLAR_NETWORK=mainnet

# Stellar Mainnet RPC endpoint (Soroban-RPC compatible).
VITE_STELLAR_RPC_URL=https://soroban.stellar.org

# Contract IDs — populated after running the mainnet deployment procedure
# described in docs/mainnet-deployment.md.
VITE_KYC_REGISTRY_ID=
VITE_COMPLIANCE_ENGINE_ID=
VITE_INVOICE_TOKEN_ID=
VITE_PROPERTY_TOKEN_ID=
VITE_CARBON_TOKEN_ID=
VITE_RWA_TOKEN_ID=
