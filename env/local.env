# env/local.env — Veritoken local network configuration
#
# Used when running a local Stellar node (e.g. stellar-quickstart or
# stellar-local-setup). Contract IDs here are populated by your local
# deploy run and will differ from testnet/mainnet.
#
# Load with:  bash scripts/load-env.sh local
# Or copy:    cp env/local.env frontend/.env

VITE_STELLAR_NETWORK=local

# RPC endpoint for a locally running Stellar Quickstart node.
# Override with STELLAR_RPC_URL if your node listens on a different port.
VITE_STELLAR_RPC_URL=http://localhost:8000/soroban/rpc

# Contract IDs — populated after running: STELLAR_NETWORK=local bash scripts/deploy.sh <identity>
VITE_KYC_REGISTRY_ID=
VITE_COMPLIANCE_ENGINE_ID=
VITE_INVOICE_TOKEN_ID=
VITE_PROPERTY_TOKEN_ID=
VITE_CARBON_TOKEN_ID=
VITE_RWA_TOKEN_ID=
