# env/testnet.env — Veritoken Stellar Testnet configuration
#
# Used during development and integration testing against Stellar Testnet.
# Contract IDs here are populated by your testnet deploy run.
#
# Load with:  bash scripts/load-env.sh testnet
# Or copy:    cp env/testnet.env frontend/.env

VITE_STELLAR_NETWORK=testnet

# Stellar Testnet RPC endpoint (Soroban-RPC compatible).
VITE_STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Contract IDs — populated after running: bash scripts/deploy.sh <identity>
VITE_KYC_REGISTRY_ID=
VITE_COMPLIANCE_ENGINE_ID=
VITE_INVOICE_TOKEN_ID=
VITE_PROPERTY_TOKEN_ID=
VITE_CARBON_TOKEN_ID=
VITE_RWA_TOKEN_ID=
