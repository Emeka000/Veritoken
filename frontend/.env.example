# Network: "testnet" | "mainnet". A custom network name is also supported as
# long as VITE_SOROBAN_RPC_URL and VITE_STELLAR_NETWORK_PASSPHRASE are both
# set below (#451) — the network switcher in the header only offers
# testnet/mainnet, but any name works when driven via env vars.
VITE_STELLAR_NETWORK=testnet
# Optional: override the RPC endpoint for the selected network (e.g. a
# private Soroban node, a forked testnet, or CI infrastructure).
VITE_SOROBAN_RPC_URL=
# Optional: override the network passphrase to match a custom RPC endpoint.
VITE_STELLAR_NETWORK_PASSPHRASE=
# Optional: "true" to allow a plaintext http:// RPC URL (e.g. a local
# standalone node). Defaults to false for every network except "standalone".
VITE_RPC_ALLOW_HTTP=
VITE_KYC_REGISTRY_ID=
VITE_COMPLIANCE_ENGINE_ID=
VITE_INVOICE_TOKEN_ID=
VITE_PROPERTY_TOKEN_ID=
VITE_CARBON_TOKEN_ID=
VITE_RWA_TOKEN_ID=
