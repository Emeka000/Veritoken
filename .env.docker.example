# Environment variables for the Docker development environment.
# Copy this file to .env.docker and fill in the values.
#
#   cp .env.docker.example .env.docker
#
# NEVER commit .env.docker to the repository — it contains secrets.
# See docs/secret-safe-deployment.md for guidance on secret handling.

# ── Network ────────────────────────────────────────────────────────────────
# Use "standalone" for local development, "testnet" for testnet work.
STELLAR_NETWORK=standalone

# Override these only if you are pointing at a remote network.
# Leave blank to use the defaults set in docker-compose.yml.
STELLAR_RPC_URL=
STELLAR_HORIZON_URL=

# ── Admin key ──────────────────────────────────────────────────────────────
# The secret key of the admin account used by deploy.sh inside the container.
# For local standalone: generate a throwaway key with `stellar keys generate`.
# NEVER use a mainnet key here. NEVER commit this value.
ADMIN_SECRET_KEY=

# ── Frontend contract IDs ──────────────────────────────────────────────────
# Populated automatically by scripts/deploy.sh.
# You can also set them manually after a manual deploy.
VITE_KYC_REGISTRY_ID=
VITE_COMPLIANCE_ENGINE_ID=
VITE_INVOICE_TOKEN_ID=
VITE_PROPERTY_TOKEN_ID=
VITE_CARBON_TOKEN_ID=
