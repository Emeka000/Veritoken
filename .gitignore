# Rust
target/
**/*.rs.bk
# Cargo.lock is intentionally committed: the contracts are deployable
# artifacts and CI builds with --locked for reproducibility.

# Frontend & Node
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.bak
frontend/.env.e2e.local

# E2E tests — generated fixtures, reports, and Playwright's own output
tests/e2e/fixtures/contract-ids.json
tests/e2e/.standalone-container
tests/e2e/.dev-server.pid
tests/e2e/test-results/
tests/e2e/playwright-report/
tests/e2e/blob-report/

# Python deployment tooling
__pycache__/
*.py[cod]

# Docker local environment — contains secrets, never commit
.env.docker

# Stellar
.stellar/
*.wasm
*.optimized.wasm

# Soroban test execution snapshots (regenerated on every `cargo test`)
**/test_snapshots/

# Deployment manifest — contains network-specific contract IDs.
# Commit this file only when you want CI drift detection to run against it.
# Do not commit mainnet contract IDs here.
# deploy-manifest.json
deploy-manifest.partial.json
deployment-verification-report.json

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
