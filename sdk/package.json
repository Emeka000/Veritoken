{
  "name": "@veritoken/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for Veritoken smart contracts on Stellar Soroban",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@stellar/stellar-sdk": ">=12.0.0"
  },
  "devDependencies": {
    "@stellar/stellar-sdk": "^12.3.0",
    "call-bound": "^1.0.4",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0",
    "which-typed-array": "^1.1.22"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "stellar",
    "soroban",
    "rwa",
    "veritoken",
    "kyc",
    "compliance"
  ],
  "license": "MIT"
}
